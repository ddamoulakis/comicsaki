# Supabase (Expo public env vars — safe for client-side anon key)
EXPO_PUBLIC_SUPABASE_URL=https://crzorsnfefshlciebeth.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# Production web URL (OAuth redirects, share links)
EXPO_PUBLIC_APP_URL=https://comicsaki.expo.app

# Google Gemini (cover scan) — https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_KEY=your-gemini-api-key-here

# Optional: Google Cloud Vision (unused in cover scan — Vision keys cannot call Gemini)
EXPO_PUBLIC_GOOGLE_VISION_KEY=your-google-vision-api-key-here

# Metron API (market / series metadata)
EXPO_PUBLIC_METRON_USER=your-metron-username
EXPO_PUBLIC_METRON_PASS=your-metron-password

# Optional: override public CDN for greekcomics scrape covers ({covId}_{filename}.jpg).
# Defaults to {EXPO_PUBLIC_SUPABASE_URL}/storage/v1/object/public/greek-covers when unset.
# During `npx expo start` without Supabase CDN, the app serves /api/greek-covers locally.
# EXPO_PUBLIC_GREEKCOMICS_COVERS_BASE=https://crzorsnfefshlciebeth.supabase.co/storage/v1/object/public/greek-covers

# Server-only: bulk upload via `npm run upload:greek-covers` (never commit).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Auto-deploy (push to main → comicsaki.expo.app) ---
# 1. Add the same EXPO_PUBLIC_* values to EAS → project → Environment variables → production
#    (or: eas env:set --name EXPO_PUBLIC_* --value ... --environment production)
# 2. Connect GitHub repo in Expo dashboard (Workflows) — uses .eas/workflows/deploy-web.yml
#    OR use GitHub Actions: add EXPO_TOKEN secret and keep .github/workflows/deploy-web.yml
#    (use only one of the two workflows to avoid double deploys)
# 3. Push to main
